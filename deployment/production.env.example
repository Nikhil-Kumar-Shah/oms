# ==============================================================================
# PARADOX SPORTS OMS - PRODUCTION BACKEND ENVIRONMENT CONFIGURATION
# Location: /etc/paradox-oms/production.env
# Permissions: chmod 600 /etc/paradox-oms/production.env (Owner: omsapp:omsapp)
# ==============================================================================

# Application Environment
APP_ENV=production
APP_NAME="Paradox Sports OMS"
APP_VERSION="1.0.0"
DEBUG=false

# Server Bind Configuration (Localhost only, behind Nginx)
HOST=127.0.0.1
PORT=8000

# Security & Cryptographic Secrets (MUST be unique, 64-char hex string in production)
# Generate via: openssl rand -hex 32
SECRET_KEY="generate_a_cryptographically_secure_random_key_for_production"

# Allowed Hosts & CORS (Restricted to production domain & local reverse proxy)
ALLOWED_HOSTS="oms.paradoxsports.org,127.0.0.1,localhost"
CORS_ORIGINS="https://oms.paradoxsports.org"
ENABLE_SECURITY_HEADERS=true
ENFORCE_HTTPS=true

# API Documentation Access Control (HTTP Basic Auth for /docs, /redoc, /openapi.json)
ENABLE_DOCS=false
API_DOCS_USERNAME="secure_docs_admin"
API_DOCS_PASSWORD="change_this_to_a_complex_password"

# Rate Limiting Parameters (Requests per minute)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# PostgreSQL Database Connection (Azure Database for PostgreSQL Flexible Server)
# Format: postgresql+psycopg2://<azure_pg_username>:<azure_pg_password>@<azure_pg_server>.postgres.database.azure.com:5432/<azure_pg_database>?sslmode=require
DATABASE_URL="postgresql+psycopg2://<azure_pg_username>:<azure_pg_password>@<azure_pg_server>.postgres.database.azure.com:5432/<azure_pg_database>?sslmode=require"

# Database Connection Pool Settings
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=25
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Logging Level (INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Session & Cookie Security
SESSION_COOKIE_NAME="oms_session"
SESSION_EXPIRE_HOURS=24
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE="lax"
