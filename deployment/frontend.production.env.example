# ==============================================================================
# PARADOX SPORTS OMS - PRODUCTION FRONTEND ENVIRONMENT CONFIGURATION
# Location: /etc/paradox-oms/frontend.production.env
# Permissions: chmod 600 /etc/paradox-oms/frontend.production.env (Owner: omsapp:omsapp)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Application Identity
NEXT_PUBLIC_APP_NAME="Paradox Sports OMS"
NEXT_PUBLIC_APP_ENV="production"

# API Base URL (Relative path to leverage Nginx unified reverse proxy on same domain)
NEXT_PUBLIC_API_BASE_URL="/api/v1"
