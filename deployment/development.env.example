# ==============================================================================
# PARADOX SPORTS OMS - LOCAL DEVELOPMENT BACKEND ENVIRONMENT
# Location: .env
# ==============================================================================

APP_ENV=development
APP_NAME="Paradox Sports OMS (Dev)"
APP_VERSION="1.0.0-dev"
DEBUG=true

HOST=127.0.0.1
PORT=8000

SECRET_KEY="dev-insecure-secret-key-do-not-use-in-prod"
ALLOWED_HOSTS="*"
CORS_ORIGINS="*"
ENABLE_SECURITY_HEADERS=false
ENFORCE_HTTPS=false

ENABLE_DOCS=true
API_DOCS_USERNAME="admin"
API_DOCS_PASSWORD="password"

RATE_LIMIT_LOGIN_PER_MINUTE=100
RATE_LIMIT_GLOBAL_PER_MINUTE=500

DATABASE_URL="postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/paradox_oms_dev"

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

LOG_LEVEL=DEBUG

SESSION_COOKIE_NAME="oms_session_dev"
SESSION_EXPIRE_HOURS=24
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE="lax"

DEV_ADMIN_USERNAME="admin"
DEV_ADMIN_PASSWORD="SecretPassword123!"
