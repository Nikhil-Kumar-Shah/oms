# ==============================================================================
# PARADOX SPORTS OPERATIONS MANAGEMENT SYSTEM (OMS)
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
APP_NAME="Paradox Sports OMS"
APP_VERSION="0.2.0"
DEBUG=false

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Security & Secrets
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production-min-32-chars

# API Documentation Access (HTTP Basic Auth for /docs, /redoc, /openapi.json)
API_DOCS_USERNAME=docs_admin
API_DOCS_PASSWORD=change-me-to-a-secure-docs-password
ENABLE_DOCS=true

# CORS & Allowed Hosts (Comma-separated in production, e.g. "https://oms.yourdomain.org")
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ORIGINS=http://localhost:3000

# PostgreSQL Database Configuration
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/paradox_oms
# Azure Database for PostgreSQL (Flexible Server with SSL enforced):
# DATABASE_URL=postgresql+psycopg2://<pg_admin_user>:<pg_password>@<azure_pg_host>.postgres.database.azure.com:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://oms_user:change_password@localhost:5432/paradox_oms

# Database Connection Pool Settings
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=25
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Logging
LOG_LEVEL=INFO

# Authentication & Session Settings
SESSION_COOKIE_NAME=oms_session
SESSION_EXPIRE_HOURS=24
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Development Seed Settings
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=change-me-in-dev-only
